# Copy this file to .env and replace only the placeholder secret values.
# Never put a real API key in this example file.

# Alibaba Cloud Model Studio / DashScope (China mainland endpoint)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen3.7-plus

# AMap Web Service API (server-side only)
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key_here
AMAP_BASE_URL=https://restapi.amap.com
